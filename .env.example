# Site adresi (canlıda https://alanadiniz.com yazın — SEO ve sitemap için)
SITE_URL=http://127.0.0.1:8000

# MySQL kullanmak için aşağıdakileri doldurun.
# MySQL şifrenizi bilmiyorsanız: USE_SQLITE=true ekleyin, proje SQLite ile çalışır.
USE_SQLITE=true

MYSQL_DATABASE=lorenza_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
