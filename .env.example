# Site adresi (canlıda https://alanadiniz.com yazın — SEO ve sitemap için)
SITE_URL=http://127.0.0.1:8000
# Google Search Console HTML etiketi doğrulama kodu (content değeri)
GOOGLE_SITE_VERIFICATION=
DEBUG=true
USE_SQLITE=true

# Canlıda kalıcı PostgreSQL (örn. Neon) bağlantısı. Bu değer varsa SQLite kullanılmaz.
# DATABASE_URL=postgresql://kullanici:sifre@host/veritabani?sslmode=require

# Render canlı örneği:
# DEBUG=false
# USE_SQLITE=true
# DJANGO_SECRET_KEY=uzun-rastgele-metin
# SITE_URL=https://lorvessamobilya.com
# ALLOWED_HOSTS=lorvessamobilya.com,www.lorvessamobilya.com
# CSRF_TRUSTED_ORIGINS=https://lorvessamobilya.com,https://www.lorvessamobilya.com
# SECURE_SSL_REDIRECT=true

MYSQL_DATABASE=lorenza_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
